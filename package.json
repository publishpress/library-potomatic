{
	"name": "@publishpress/potomatic",
	"version": "1.4.16",
	"description": "AI-powered translation utility for translating .po(t) files into multiple languages",
	"author": "PublishPress",
	"keywords": [
		"ai",
		"gpt",
		"translation",
		"po",
		"pot",
		"OpenAI",
		"gpt",
		"i18n",
		"gettext",
		"localization",
		"WordPress"
	],
	"homepage": "https://www.gravitykit.com/potomatic/",
	"bugs": {
		"url": "https://github.com/publishpress/library-potomatic/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/publishpress/library-potomatic.git"
	},
	"type": "module",
	"main": "potomatic",
	"files": [
		"potomatic",
		"src/",
		"config/",
		"CHANGELOG.md",
		"LICENSE.md",
		"README.md"
	],
	"bin": {
		"potomatic": "potomatic"
	},
	"scripts": {
		"translate": "./potomatic",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{js,json}\"",
		"format:check": "prettier --check \"**/*.{js,json}\"",
		"prepublishOnly": "npm run lint && npm run format:check && npm test"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^12.0.0",
		"dotenv": "^16.5.0",
		"extract-zip": "^2.0.1",
		"gettext-parser": "^8.0.0",
		"listr2": "^8.0.0",
		"node-fetch": "^3.3.2",
		"openai": "^6.0.0",
		"tiktoken": "^1.0.22",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.1.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-promise": "^6.6.0",
		"execa": "^8.0.1",
		"nock": "^13.5.4",
		"prettier": "^3.5.3",
		"tmp": "^0.2.3",
		"vitest": "^3.1.4"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
